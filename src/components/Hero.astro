---
import TechIcon from './TechIcon.astro';
import { site, hero } from '@/data/site';
const letters = (word: string, start: number) => word.split('').map((ch, i) => ({ ch, delay: `${start + i * 45}ms` }));
const first = letters(site.first, 150);
const last = letters(site.last, 420);
const cta = site.bookingUrl || '#contact';
---
<section class="herowrap" id="top">
  <div class="stage">
    <div class="hero-ring r1 hide-sm" aria-hidden="true"></div>
    <div class="hero-ring r2 hide-sm" aria-hidden="true"></div>
    <div class="hero-meta fade" style="animation-delay:100ms">
      <span style="display:inline-flex;align-items:center;gap:10px"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent)"></span>Portfolio · {new Date().getFullYear()}</span>
      <span>Lahore, PK · open to relocation</span>
    </div>
    <h1 class="hero-name shrink" aria-label={site.name}>
      <span class="line p1" aria-hidden="true">{first.map((l) => <span class="lm"><span style={`animation-delay:${l.delay}`}><span class="lt">{l.ch}</span></span></span>)}</span>
      <span class="line line2 p2" aria-hidden="true">{last.map((l) => <span class="lm"><span style={`animation-delay:${l.delay}`}><span class="lt">{l.ch}</span></span></span>)}</span>
    </h1>
    <div class="hero-foot">
      <div class="hero-copy">
        <p class="role fade" style="animation-delay:700ms">
          <span class="accent">&gt;</span> <span id="role-text" aria-hidden="true">{hero.roles[0]}</span><span class="caret" aria-hidden="true"></span>
          <span class="sr-only">Senior Full-Stack Developer becoming a Solutions Architect</span>
        </p>
        <p class="hero-intro fade dim" style="animation-delay:820ms">{hero.intro}</p>
        <div class="fade" style="display:flex;gap:12px;flex-wrap:wrap;animation-delay:920ms">
          <a class="btn btn-primary" href={cta}>Book an architecture call <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn btn-outline" href="#trajectory">See my journey</a>
        </div>
      </div>
      <div class="hero-side">
        <span class="hero-tagline reveal">Full-stack today. <span class="warm">Architect next.</span></span>
        <div class="logo-row fade" aria-label="Core stack" style="animation-delay:1.1s">
          {hero.stack.map((k) => <TechIcon name={k} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { hero } from '@/data/site';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Role line: each phrase decodes from random glyphs, holds, then the next one starts.
  const el = document.getElementById('role-text');
  if (el && !reduce) {
    const glyphs = '<>/{}[]=+*#01ABCDEFGHJKLMNPRSTUVWXYZ';
    let idx = 0, revealed = 0, hold = 0;
    setInterval(() => {
      const target = hero.roles[idx];
      if (revealed < target.length) {
        revealed += 0.6;
        const n = Math.floor(revealed);
        let s = target.slice(0, n);
        for (let i = n; i < Math.min(target.length, n + 5); i++) s += target[i] === ' ' ? ' ' : glyphs[Math.floor(Math.random() * glyphs.length)];
        el.textContent = s;
      } else if (++hold === 1) {
        el.textContent = target;
      } else if (hold > 60) {
        hold = 0; revealed = 0; idx = (idx + 1) % hero.roles.length;
      }
    }, 40);
  }

  // The name's weight follows the cursor: letters near the pointer get heavier.
  const letters = Array.from(document.querySelectorAll<HTMLElement>('.hero-name .lt'));
  if (letters.length && !reduce && matchMedia('(pointer: fine)').matches) {
    let raf = 0, cx = 0, cy = 0;
    const paint = () => {
      raf = 0;
      for (const l of letters) {
        const r = l.getBoundingClientRect();
        const d = Math.hypot(cx - (r.left + r.width / 2), cy - (r.top + r.height / 2));
        l.style.fontVariationSettings = `'wght' ${(340 + 360 * Math.exp(-(d * d) / (2 * 170 * 170))).toFixed(0)}`;
      }
    };
    const stage = document.querySelector('.herowrap');
    stage?.addEventListener('pointermove', (e) => { const p = e as PointerEvent; cx = p.clientX; cy = p.clientY; if (!raf) raf = requestAnimationFrame(paint); });
    stage?.addEventListener('pointerleave', () => { for (const l of letters) l.style.fontVariationSettings = ''; });
  }
</script>
