---
// The Orbit monogram: M and H in a teal ring with the coral "next step" dot.
interface Props { size?: number }
const { size = 34 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" style="display:block;flex:none">
  <circle cx="50" cy="50" r="42" fill="none" stroke="var(--accent)" stroke-width="5" />
  <path d="M27 64V36l11.5 16L50 36v28M58 36v28M74 36v28M58 50h16" fill="none" stroke="var(--accent)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="79.7" cy="20.3" r="9" fill="var(--warm-fill)" />
</svg>
